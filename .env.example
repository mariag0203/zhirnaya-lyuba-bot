# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_chat_id_here

# Database
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Какие мониторы запускать (через запятую): mosbilet, shalom_site, afisha
ENABLED_MONITORS=mosbilet

# Интервал проверки, секунд. Меньше 60 не бывает (жёсткий минимум в коде).
BASE_INTERVAL=90

# Мосбилет: точное название спектакля; при необходимости — доп. ID событий
MOSBILET_TITLE=Жирная Люба
MOSBILET_EVENT_IDS=
