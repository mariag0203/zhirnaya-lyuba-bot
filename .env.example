# Telegram-бот (токен выдаёт @BotFather). Файл .env в git не попадает.
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_chat_id_here

# База данных
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Интервал проверки, секунд. Меньше 60 не бывает (жёсткий минимум в коде).
BASE_INTERVAL=90

# ID спектакля на Мосбилете: https://bilet.mos.ru/event/381336257/
MOSBILET_EVENT_ID=381336257

# Не повторять уведомление о местах на один показ чаще, чем раз в N минут (0 — без ограничения)
NOTIFY_COOLDOWN_MIN=10

# Через сколько проверок подряд без найденных показов написать администратору
PARSE_ALERT_AFTER=5

# Час по Москве для ежедневного «я работаю» администратору (-1 — выключить)
HEARTBEAT_HOUR=10
